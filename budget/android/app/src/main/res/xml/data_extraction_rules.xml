<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Keep the Firefly token (flutter_secure_storage) out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
